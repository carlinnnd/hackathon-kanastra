# Integração Oficial Vercel Marketplace Auth0 (https://vercel.com/marketplace/auth0)
# Quando você instala o Auth0 pelo Marketplace da Vercel (ou cria uma SPA no Auth0),
# defina estas variáveis nas Environment Variables da Vercel (ou no arquivo .env do frontend):

VITE_AUTH0_DOMAIN=seu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=seu_client_id_publico

# Compatibilidade automática também com nomes padrão da integração Vercel:
NEXT_PUBLIC_AUTH0_DOMAIN=seu-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=seu_client_id_publico

