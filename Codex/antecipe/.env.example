# Configurações de Ambiente — Antecipe FIDC
DATABASE_URL=sqlite:///./antecipe.db
# Para PostgreSQL via Compose:
# DATABASE_URL=postgresql://antecipe:sua_senha_segura_db@localhost:5432/antecipe_db


# Token para publicação e ativação de regras administrativas (cabeçalho X-Admin-Token).
# Por padrão de segurança, deixe vazio ou comente para desabilitar mutações administrativas (retorna HTTP 503).
# Para habilitar operações administrativas em seu ambiente local ou homologação, defina uma chave forte:
# ADMIN_TOKEN=
ADMIN_TOKEN=

# Limite máximo de upload em bytes (padrão 100MB)
MAX_UPLOAD_SIZE_BYTES=104857600

# Caminhos padrão dos arquivos
ESTOQUE_CSV_PATH=../../estoque_antecipe_100k/estoque_antecipe.csv
VALIDADORES_JSON_PATH=../../validadores_antecipe.json

# Modo de Demonstração Cadastral:
# false: padrão conservador obrigatório de produção (qualquer sacado não verificado é tratado como NAO_VERIFICADA)
# true: ativa fixture sintética com empresas de demonstração mapeadas explicitamente para apresentação
ENABLE_DEMO_CADASTRO=false

LOG_LEVEL=INFO

# Auth0: configure valores reais somente no ambiente, nunca no frontend.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DB_CONNECTION=Username-Password-Authentication
